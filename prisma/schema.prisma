generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH — custom database-backed sessions (HTTP-only cookie holds only the
// opaque session token; every request looks the token up here, so a session
// can be revoked instantly by deleting the row).
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  bookings     Booking[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?   // simple emoji / icon key rendered on the category card
  sortOrder   Int       @default(0)
  services    Service[]

  @@index([sortOrder])
}

model Service {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  description   String
  durationMins  Int          // used for slot generation & conflict checks
  priceCents    Int          // stored in cents to avoid float rounding issues
  imageUrl      String?
  isActive      Boolean      @default(true)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  staff         StaffService[]
  bookings      Booking[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// STAFF
// ---------------------------------------------------------------------------

model Staff {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  title       String          // e.g. "Senior Colorist"
  bio         String
  photoUrl    String?
  isActive    Boolean         @default(true)
  services    StaffService[]
  schedules   WeeklySchedule[]
  timeOff     TimeOff[]
  bookings    Booking[]
  createdAt   DateTime        @default(now())

  @@index([isActive])
}

// Many-to-many: which staff can perform which services
model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

// Recurring weekly working hours, e.g. Tue 09:00-17:00
model WeeklySchedule {
  id        String @id @default(cuid())
  staffId   String
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 0 = Sunday ... 6 = Saturday
  startMin  Int    // minutes from midnight, e.g. 540 = 09:00
  endMin    Int    // e.g. 1020 = 17:00

  @@index([staffId, dayOfWeek])
}

// One-off exceptions: vacation, sick day, holiday closure, or an extra shift
model TimeOff {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime // date-only (stored at midnight UTC)
  startMin  Int?     // null + null = whole day off
  endMin    Int?
  reason    String?

  @@index([staffId, date])
}

// ---------------------------------------------------------------------------
// BOOKINGS
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id           String        @id @default(cuid())
  customerId   String
  customer     User          @relation(fields: [customerId], references: [id])
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id])
  staffId      String
  staff        Staff         @relation(fields: [staffId], references: [id])
  startsAt     DateTime      // exact appointment start (UTC)
  endsAt       DateTime      // startsAt + service.durationMins, cached for fast overlap queries
  priceCents   Int           // snapshot of price at time of booking
  status       BookingStatus @default(PENDING)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Every reschedule keeps history by pointing at the booking it replaced
  rescheduledFromId String?  @unique
  rescheduledFrom   Booking? @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Booking? @relation("Reschedule")

  @@index([staffId, startsAt, endsAt])
  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// SALON INFO (single row) — used by the contact/location page & branding
// ---------------------------------------------------------------------------

model SalonInfo {
  id          String @id @default(cuid())
  name        String
  tagline     String
  addressLine String
  city        String
  phone       String
  email       String
  mapEmbedUrl String?
  hoursNote   String
}
