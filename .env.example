# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/salon_db?schema=public"

# REQUIRED. Random 32+ char secret. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=""

# REQUIRED for `npm run db:seed` — there is no default admin account.
# Password must be 12+ characters and not a known placeholder value
# (the seed script actively rejects things like "ChangeMe123!" or "admin123").
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional. Set to "true" ONLY in local/staging environments if you want a
# demo customer account seeded for testing the booking flow without
# registering. Ignored (and warned about) if NODE_ENV=production, and should
# be left unset/false everywhere else, including staging once you're done
# with it.
SEED_DEMO_DATA="false"

# Optional: Cloudinary (image uploads for services/staff photos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Stripe (deposit / prepayment on booking)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
